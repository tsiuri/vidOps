# Path convention: hardcodes /home/billie/bq_netservices/vidops to match
# motherbase install. For deployment elsewhere, substitute the actual install
# path or use systemd %h specifier (e.g. WorkingDirectory=%h/...) for portability.

[Unit]
Description=VidOps Storage Broker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=billie
WorkingDirectory=/home/billie/bq_netservices/vidops
Environment=PYTHONPATH=/home/billie/bq_netservices/vidops
ExecStart=/home/billie/bq_netservices/vidops/.venv/bin/python scripts/storage_broker_server.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target

